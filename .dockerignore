# Keep the Docker build context limited to the application runtime.
*

!Dockerfile
!pyproject.toml
!uv.lock
!run.py
!app/
!app/**
!templates/
!templates/**
!static/
!static/**

# Local/generated runtime state must never enter the image context.
**/__pycache__/
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.db
app/data/
app/data/**
data/
data/**
config/
config/**
.env
.machine_id

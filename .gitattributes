# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for Python files
*.py text eol=lf
*.pyw text eol=lf

# Force LF for other text files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary

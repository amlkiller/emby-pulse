# ==========================================
# EmbyPulse 环境变量配置
# ==========================================
# 复制此文件为 .env 并填写实际值

# ==========================================
# 🔒 核心安全配置（可选）
# ==========================================

# Session 密钥（用于加密 Session Cookie）
# ⚠️ 如果不设置，系统会每次启动自动生成随机值
# - 存储在内存中，重启后重新生成
# - 重启后所有用户的 Session 会失效，需要重新登录
# 
# 何时需要手动设置：
# - 不希望用户每次重启后重新登录
# - 多实例部署（多个容器共享同一个 SECRET_KEY）
# 
# 生成方式：openssl rand -hex 32
SECRET_KEY=

# ==========================================
# 🔒 Telegram Bot 配置
# ==========================================

# TG 管理机器人 Token（从 @BotFather 获取）
# 格式：123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TG_BOT_TOKEN=

# TG 用户机器人 Token（用于开放注册等功能）
# 如果不使用用户机器人功能，可以留空
TG_USER_BOT_TOKEN=

# TG Chat ID（接收通知的用户/群组 ID）
# ⚠️ 可以在后台配置，无需通过环境变量设置
# 获取方式：给机器人发消息，然后访问 https://api.telegram.org/bot<你的TOKEN>/getUpdates
# TG_CHAT_ID=

# ==========================================
# 🔒 Emby 配置
# ==========================================

# Emby API Key（从 Emby 后台获取）
# 获取方式：Emby 后台 -> 设置 -> API 密钥 -> 创建新密钥
EMBY_API_KEY=

# Emby 服务器地址（首次初始化时使用）
# 格式：http://IP:端口 或 https://域名
EMBY_HOST=http://192.168.31.2:8096

# ==========================================
# 🔒 TMDB 配置
# ==========================================

# TMDB API Key（用于获取电影/剧集信息）
# 获取方式：https://www.themoviedb.org/settings/api -> 创建新应用
TMDB_API_KEY=

# ==========================================
# 🔒 MoviePilot 配置（可选）
# ==========================================

# MoviePilot Token（如果使用 MoviePilot 自动订阅）
MOVIEPILOT_TOKEN=

# ==========================================
# 🔒 Webhook 配置
# ==========================================

# Webhook Token（用于 Emby Webhook 验证）
# 建议使用随机字符串，防止未授权访问
# 生成方式：openssl rand -hex 16
WEBHOOK_TOKEN=

# ==========================================
# 🔒 企业微信配置（可选）
# ==========================================

# 企业微信 CorpID（企业ID）
# 获取方式：企业微信后台 -> 我的企业 -> 企业信息
# WECOM_CORPID=

# 企业微信 CorpSecret（应用密钥）
# 获取方式：企业微信后台 -> 应用管理 -> 选择应用 -> 查看Secret
WECOM_CORPSECRET=

# 企业微信 AgentID（应用ID）
# 获取方式：企业微信后台 -> 应用管理 -> 选择应用 -> 查看AgentId
# WECOM_AGENTID=

# 企业微信 Token（用于消息回调验证）
# 设置方式：企业微信后台 -> 应用管理 -> 设置API接收 -> 设置Token
WECOM_TOKEN=

# 企业微信 EncodingAESKey（用于消息加密）
# 设置方式：企业微信后台 -> 应用管理 -> 设置API接收 -> 设置EncodingAESKey
WECOM_AESKEY=

# ==========================================
# 🌐 其他配置（可选）
# ==========================================

# 是否启用本地认证
# true: 启用本地账号登录
# false: 仅使用 Emby 账号登录

# LOCAL_AUTH_ENABLED=false
# LOCAL_ADMIN_USERNAME=xiaoyu #本地用户名
# LOCAL_ADMIN_PASSWORD=Cici0512.8023mm #本地账号密码，开启本地账号后可以进入后台设置中禁用emby管理员账号登录

# FORCE_MIGRATE=1 #强制迁移数据库，仅迁移时填写，完成后务必删除

# PORT=10307 #容器内服务端口,可自定义，不填默认为10307
# REQUEST_PORT=10308 #用户中心后台端口，可自定义，不填默认为10308

# AUTO_MIGRATE_DB=1 #自动数据迁移开关


# ==========================================
# 📝 使用说明
# ==========================================
#
# 🔒 安全机制：
# 1. 环境变量设置的敏感字段会自动清除配置文件中的对应值
# 2. 前端界面显示这些字段为只读状态，无法修改
# 3. 代码层面禁止保存环境变量控制的敏感字段
#
# 🔄 修改流程：
# 1. 修改 .env 文件或 Docker 环境变量
# 2. 重启服务
# 3. 配置文件中的旧值会被自动清除
#
# ==========================================
# 🚀 Docker Compose 示例
# ==========================================
#
# version: '3.8'
# services:
#   emby-pulse:
#     image: zeyu8023/embypulse-pro:latest
#     container_name: emby-pulse
#     restart: unless-stopped
#     network_mode: host
#     volumes:
#       - /volume1/docker/emby/data:/emby-data
#       - /volume1/docker/emby-pulse/config:/workspace/config
#       - /volume1/docker/emby-pulse/data:/workspace/data
#     env_file:
#       - .env
#
